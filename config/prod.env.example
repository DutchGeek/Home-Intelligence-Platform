# HIP Production Deployment Configuration
# Copy to config/prod.env and edit values for your environment.

# Deployment target selector.
HIP_DEPLOY_TARGET=production

# Home Assistant production container name.
HIP_CONTAINER_NAME=homeassistant

# Home Assistant base URL for API calls.
HIP_HA_URL=http://homeassistant.local:8123

# Home Assistant Long-Lived Access Token (required).
HIP_HA_TOKEN=

# Maximum startup wait time (seconds) after restart.
HIP_WAIT_TIMEOUT=300

# Git remote and branch used by optional pull.
HIP_GIT_REMOTE=origin
HIP_GIT_BRANCH=main

# Enable optional git pull --ff-only before deployment.
HIP_GIT_PULL=true

# Ask for interactive confirmation before deployment.
HIP_CONFIRM_DEPLOYMENT=true
