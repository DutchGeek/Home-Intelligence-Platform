# HIP Production Deployment Configuration
# Store the real file outside this repository:
# /mnt/apps/configs/hip/prod.env

# Deployment target selector used by tooling.
HIP_DEPLOY_TARGET=production

# Home Assistant production container name.
HIP_CONTAINER_NAME=homeassistant

# Home Assistant base URL for API calls.
HIP_HA_URL=http://your-ha-prod:8123

# Home Assistant Long-Lived Access Token (required).
HIP_HA_TOKEN=<LONG_LIVED_TOKEN>

# Maximum startup wait time in seconds after container restart.
HIP_WAIT_TIMEOUT=300

# Remote name used for optional git pull --ff-only.
HIP_GIT_REMOTE=origin

# Branch used for optional git pull --ff-only.
HIP_GIT_BRANCH=main

# Enable optional git pull before deployment.
HIP_GIT_PULL=true

# Require a clean git tree for production deployments.
# Keep true for safety.
HIP_REQUIRE_CLEAN_TREE=true

# Ask for interactive confirmation before executing deployment steps.
HIP_CONFIRM_DEPLOYMENT=true

# Optional repository location override.
# If set, scripts use this path instead of their auto-detected repo path.
HIP_REPOSITORY=/mnt/apps/hip

# Optional host-side Home Assistant config location for operator reference.
# Runtime deployment still targets /config inside the container.
HIP_CONFIG_PATH=/mnt/apps/configs/ha-prod-stack/homeassistant/config
